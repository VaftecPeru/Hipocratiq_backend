APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

#DB_CONNECTION=pgsql
#DB_URL=${{Postgres.DATABASE_URL}}
#APP_URL=https://hipocratiqbackend-production.up.railway.app
#CORS_ALLOWED_ORIGINS=https://hipocratiq-frontend-u9he.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=back_api
DB_USERNAME=back_api
DB_PASSWORD=back_api_local

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=redis_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_RESENDS=5
OTP_HASH_KEY=
OTP_FIXED_CODE=
AUTH_SESSION_ABSOLUTE_MINUTES=720
# DEMO_MODE=true permite SMS array + OTP fijo + billing simulado aun con APP_ENV=production (solo demos).
DEMO_MODE=false
# SMS queda deshabilitado por defecto. El OTP de acceso por correo usa Laravel Mail.
SMS_DRIVER=unavailable
BILLING_DRIVER=unavailable
# Gateway HTTP real: el endpoint externo debe responder status=succeeded antes de activar la suscripción.
BILLING_HTTP_ENDPOINT=
BILLING_HTTP_TOKEN=
BILLING_HTTP_TIMEOUT_SECONDS=20

# IA epidemiológica: sólo recibe métricas agregadas, nunca PII clínica individual.
EPIDEMIOLOGICAL_AI_ENABLED=false
EPIDEMIOLOGICAL_AI_PROVIDER=unavailable
EPIDEMIOLOGICAL_AI_BASE_URL=https://api.openai.com/v1
EPIDEMIOLOGICAL_AI_API_KEY=
EPIDEMIOLOGICAL_AI_MODEL=
EPIDEMIOLOGICAL_AI_TIMEOUT_SECONDS=20
EPIDEMIOLOGICAL_AI_MAX_OUTPUT_TOKENS=1200

# Telemedicina: configurar una instancia Jitsi aprobada para producción.
TELEMEDICINE_PROVIDER=unavailable
TELEMEDICINE_BASE_URL=
TELEMEDICINE_ROOM_PREFIX=hipocratiq
TELEMEDICINE_ROOM_SECRET=

# WhatsApp Cloud API. La versión Graph se declara por entorno para evitar hardcode obsoleto.
WHATSAPP_DRIVER=unavailable
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APPOINTMENT_TEMPLATE=
WHATSAPP_APPOINTMENT_LANGUAGE=es_MX
WHATSAPP_APPOINTMENT_REMINDER_MINUTES=1440
WHATSAPP_TIMEOUT_SECONDS=15

# Backups PostgreSQL con manifiesto SHA-256 y restore explícito por CLI.
BACKUP_SERVICE_ENABLED=false
BACKUP_SERVICE_PROVIDER=postgresql
BACKUP_STORAGE_DISK=s3
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily@02:00
BACKUP_PREFIX=hipocratiq
BACKUP_TIMEOUT_SECONDS=300
BACKUP_RESTORE_TIMEOUT_SECONDS=600

AUTH_MOBILE_TOKEN_MINUTES=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_LIMITER_STORE=redis_limiter
CACHE_PREFIX=hipocratiq_${APP_ENV}_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=back_api_redis_local
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_LIMITER_DB=3
REDIS_LOCKS_DB=4
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=locks
REDIS_LIMITER_CONNECTION=limiter
REDIS_PERSISTENT=false
REDIS_CONNECT_TIMEOUT=2
REDIS_READ_TIMEOUT=2
REDIS_PREFIX=hipocratiq_${APP_ENV}_redis_

# OTP por correo: SMTP real en producción.
# En Laravel 13 config/mail.php usa MAIL_SCHEME (no MAIL_ENCRYPTION).
# Para SMTP/STARTTLS por puerto 587, MAIL_SCHEME puede quedar vacío; Symfony Mailer negocia TLS cuando el servidor lo soporta.
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=hipocratiq.com
MAIL_FROM_ADDRESS="soporte@hipocratiq.com"
MAIL_FROM_NAME="HIPOCRATIQ"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
