APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

#DB_CONNECTION=pgsql
#DB_URL=${{Postgres.DATABASE_URL}}
#APP_URL=https://hipocratiqbackend-production.up.railway.app
#CORS_ALLOWED_ORIGINS=https://hipocratiq-frontend-u9he.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=back_api
DB_USERNAME=back_api
DB_PASSWORD=back_api_local

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_STORE=redis_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_RESENDS=5
OTP_HASH_KEY=
OTP_FIXED_CODE=
AUTH_SESSION_ABSOLUTE_MINUTES=720
SMS_DRIVER=array
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
AUTH_MOBILE_TOKEN_MINUTES=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_LIMITER_STORE=redis_limiter
CACHE_PREFIX=hipocratiq_${APP_ENV}_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=back_api_redis_local
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_LIMITER_DB=3
REDIS_LOCKS_DB=4
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=locks
REDIS_LIMITER_CONNECTION=limiter
REDIS_PERSISTENT=false
REDIS_CONNECT_TIMEOUT=2
REDIS_READ_TIMEOUT=2
REDIS_PREFIX=hipocratiq_${APP_ENV}_redis_

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
